---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
    title="AI Automation Agency Malaysia | Done-for-You AI Agents and Workflows"
    description="We deploy custom AI agents and automation pipelines for Malaysian SMEs. Zero missed leads, automated back-office, AI voice agents. Scale your output without adding headcount."
>
    <header class="hero">
        <div class="hero-left">
            <span class="label-micro" style="border: 1px solid var(--black); padding: 4px 8px; border-radius: var(--radius-pill);">For SME Owners</span>
            <h1 class="text-display">Turn More Inquiries Into Booked Clients With AI-Powered Follow-Up.</h1>
            <p class="text-h3" style="margin-top: 0.5rem; margin-bottom: 0.5rem;">AI Automation Agency for Malaysian SMEs</p>
            <p class="text-body-lg">Automate lead capture, qualification, CRM updates, and missed inquiry recovery for Malaysian professional service SMEs.</p>
            <div class="hero-btns" style="display: flex; gap: 1rem;">
                <a href="https://ai-self-audit.autoflow-solutions.com/" class="btn btn-solid">Start Free AI Self Audit</a>
                <a href="/my/tools/automation-roi-calculator" class="btn btn-outline">Calculate Your Automation ROI</a>
            </div>
        </div>
        <div class="hero-right">
            <div class="cluster-wrapper">
                
                <div class="ui-card card-1">
                    <div class="card-header">
                        <span class="label-micro">Process 01: Ingestion</span>
                        <span class="status"></span>
                    </div>
                    <h3 class="text-h3" style="margin-bottom: 8px;">Invoice Extraction</h3>
                    <p class="text-body" style="font-size: 0.85rem; margin-bottom: 16px;">AI reads incoming PDFs, extracts line items, and flags discrepancies instantly.</p>
                    <div style="background: var(--gray-light); height: 4px; border-radius: 2px; width: 100%; margin-bottom: 4px;">
                        <div style="background: var(--black); height: 100%; width: 100%; border-radius: 2px;"></div>
                    </div>
                    <span class="label-micro" style="color: var(--black);">100% Automated</span>
                </div>

                <div class="ui-card card-2">
                    <div class="card-header">
                        <span class="label-micro">Process 02: Routing</span>
                        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                    </div>
                    <h3 class="text-h3" style="margin-bottom: 8px;">CRM Sync</h3>
                    <p class="text-body" style="font-size: 0.85rem; margin-bottom: 12px;">Data maps directly to Salesforce/HubSpot without human entry.</p>
                    <div style="display: flex; gap: 4px;">
                        <span style="padding: 2px 6px; border: 1px solid var(--gray-dark); border-radius: 4px; font-size: 0.7rem; font-family: monospace;">API_REQ</span>
                        <span style="padding: 2px 6px; border: 1px solid var(--gray-dark); border-radius: 4px; font-size: 0.7rem; font-family: monospace;">SUCCESS</span>
                    </div>
                </div>

                <div class="ui-card card-3">
                    <svg class="doodle-arrow" role="img" aria-label="Annotation: You save 20+ hours a week" viewBox="0 0 200 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M10 50 C 50 10, 150 10, 190 50" stroke="#050505" stroke-width="4" stroke-linecap="round"></path>
                        <path d="M170 30 L 195 55 L 160 70" stroke="#050505" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path>
                        <text x="60" y="20" font-family="'Gloria Hallelujah', cursive, sans-serif" font-size="18" fill="#050505" transform="rotate(-10 60 20)">You save 20+ hrs/wk!</text>
                    </svg>

                    <div class="card-header">
                        <span class="label-micro">Output: Dashboard</span>
                    </div>
                    <h3 class="text-h3" style="margin-bottom: 8px;">Reconciliation</h3>
                    <div style="display: flex; align-items: baseline; gap: 8px;">
                        <span style="font-size: 2.5rem; font-weight: 900; letter-spacing: -0.05em;">$0.00</span>
                        <span class="label-micro">Discrepancy</span>
                    </div>
                    <a href="#" class="btn btn-solid" style="width: 100%; margin-top: 16px; padding: 0.5rem; font-size: 0.85rem;">View Report</a>
                </div>

            </div>
        </div>
    </header>

    <div class="marquee-container">
        <div class="marquee-content">
            NO JARGON • JUST ROI • BUILT FOR SMES • NO JARGON • JUST ROI • BUILT FOR SMES • NO JARGON • JUST ROI • BUILT FOR SMES • NO JARGON • JUST ROI • BUILT FOR SMES • 
            NO JARGON • JUST ROI • BUILT FOR SMES • NO JARGON • JUST ROI • BUILT FOR SMES • NO JARGON • JUST ROI • BUILT FOR SMES • NO JARGON • JUST ROI • BUILT FOR SMES • 
        </div>
    </div>

    <section class="density-section density-section--gray">
        <div class="container">
            <div class="section-header" style="text-align: center; margin-bottom: 2rem;">
                <h2 class="text-h2">Where Malaysian SME teams lose time and revenue.</h2>
            </div>
            <ul class="brand-list">
                <li>Leads sit too long without follow-up</li>
                <li>Staff answer the same questions repeatedly</li>
                <li>Customer details never make it into the CRM properly</li>
                <li>Admin work delays sales and service</li>
            </ul>
        </div>
    </section>

    <section class="density-section">
        <div class="container">
            <div class="section-header">
                <h2 class="text-h2" style="margin-bottom: 1rem;">What we build.</h2>
                <p class="text-body-lg">We engineer specific, robust workflows that integrate deeply with the tools you already use.</p>
            </div>
        </div>

        <div class="blueprint-grid" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));">
            <div class="blueprint-cell">
                <span class="cell-id">CAP.01</span>
                <div class="icon-box">
                    <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--neon)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                </div>
                <h4 class="text-h3" style="margin-bottom: 0.5rem;">Lead Handling</h4>
                <p class="text-body" style="font-size: 0.9rem;">Capture, qualify, and route inquiries from WhatsApp, web chat, and forms.</p>
            </div>

            <div class="blueprint-cell blueprint-cell--featured">
                <span class="cell-id">CAP.02</span>
                <div class="icon-box">
                    <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--neon)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                </div>
                <h4 class="text-h3" style="margin-bottom: 0.5rem;">Workflow Automation</h4>
                <p class="text-body" style="font-size: 0.9rem;">Sync CRMs, trigger onboarding, generate documents, and alert the right people.</p>
            </div>

            <div class="blueprint-cell">
                <span class="cell-id">CAP.03</span>
                <div class="icon-box">
                    <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--neon)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect><rect x="9" y="9" width="6" height="6"></rect><line x1="9" y1="1" x2="9" y2="4"></line><line x1="15" y1="1" x2="15" y2="4"></line><line x1="9" y1="20" x2="9" y2="23"></line><line x1="15" y1="20" x2="15" y2="23"></line><line x1="20" y1="9" x2="23" y2="9"></line><line x1="20" y1="15" x2="23" y2="15"></line><line x1="1" y1="9" x2="4" y2="9"></line><line x1="1" y1="15" x2="4" y2="15"></line></svg>
                </div>
                <h4 class="text-h3" style="margin-bottom: 0.5rem;">AI Task Execution</h4>
                <p class="text-body" style="font-size: 0.9rem;">Use AI workers to handle repetitive research, updates, summaries, and cross-system actions.</p>
            </div>
        </div>
    </section>

    <section class="density-section density-section--gray">
        <div class="container">
            <div class="section-header" style="text-align: center; margin-bottom: 2rem;">
                <h2 class="text-h2">What this should improve.</h2>
                <p class="text-body-lg">Outcomes Malaysian SMEs see once the system is in place.</p>
            </div>
            <div class="outcome-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); border-top: 1px solid var(--black); border-bottom: 1px solid var(--black); background-color: var(--white);">
                <div class="stat-cell">
                    <span class="stat-figure">40%</span>
                    <span class="stat-label">Fewer no-shows on booked appointments</span>
                    <span class="stat-source">After-hours follow-up automation</span>
                </div>
                <div class="stat-cell">
                    <span class="stat-figure"><mark>20+</mark></span>
                    <span class="stat-label">Hours/week given back to the team</span>
                    <span class="stat-source">Lead capture, CRM sync, routing</span>
                </div>
                <div class="stat-cell">
                    <span class="stat-figure">&lt;3s</span>
                    <span class="stat-label">Response time on inbound inquiries</span>
                    <span class="stat-source">WhatsApp, web chat, forms</span>
                </div>
            </div>
        </div>
    </section>

    <section class="density-section">
        <div class="container">
            <div class="section-header" style="text-align: center; margin-bottom: var(--space-md);">
                <h2 class="text-h2">How we work.</h2>
            </div>
        </div>
        <div class="process-strip">
            <div class="step-cell">
                <span class="step-num" aria-hidden="true">01</span>
                <h4 class="text-h3" style="margin-bottom: 0.5rem;">Audit your current process</h4>
                <p class="text-body" style="font-size: 0.9rem;">We map every manual step and rank the highest-ROI fixes first.</p>
            </div>
            <div class="step-cell">
                <span class="step-num" aria-hidden="true">02</span>
                <h4 class="text-h3" style="margin-bottom: 0.5rem;">Design the right automation flow</h4>
                <p class="text-body" style="font-size: 0.9rem;">Architecture, integrations, and success metrics, locked before any code.</p>
            </div>
            <div class="step-cell">
                <span class="step-num" aria-hidden="true">03</span>
                <h4 class="text-h3" style="margin-bottom: 0.5rem;">Build, test, and launch</h4>
                <p class="text-body" style="font-size: 0.9rem;">Shipped inside your stack. Dry-run on real data. Rollback path included.</p>
            </div>
            <div class="step-cell">
                <span class="step-num" aria-hidden="true">04</span>
                <h4 class="text-h3" style="margin-bottom: 0.5rem;">Monitor and improve</h4>
                <p class="text-body" style="font-size: 0.9rem;">Weekly health checks, tuned thresholds, ownership stays with you.</p>
            </div>
        </div>
    </section>

    <section class="density-section density-section--inverse">
        <div class="container">
            <h2 class="text-h2" style="margin-bottom: 2rem;">See where automation will pay off first</h2>
            <div class="cta-stripe-actions">
                <a href="https://ai-self-audit.autoflow-solutions.com/" class="btn btn-neon">Start Free AI Self Audit</a>
                <a href="/my/tools/automation-roi-calculator" class="btn btn-outline-light">Calculate Your Automation ROI</a>
            </div>
        </div>
    </section>
</BaseLayout>
