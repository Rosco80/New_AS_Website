---
import BaseLayout from '../../layouts/BaseLayout.astro';

const positions = [
    {
        title: "Jurutera Automasi AI",
        engagement: "Kontrak · Berasaskan projek · Jarak jauh",
        hook: "Anda mengubah kekacauan manual kepada sistem yang bergerak sendiri.",
        bullets: [
            "Bina aliran kerja dan ejen AI dalam Make.com, n8n dan API kustom",
            "Hubungkan CRM, WhatsApp, pembayaran dan alat yang benar-benar digunakan PKS",
            "Hantar automasi berdaya tahan yang mampu menangani data dunia sebenar"
        ],
        subject: "Permohonan - Jurutera Automasi AI",
        isOpen: false
    },
    {
        title: "Pembangun Full-Stack",
        engagement: "Kontrak · Berasaskan projek · Jarak jauh",
        hook: "Bagi situasi di mana alatan tanpa-kod mencecah batasannya.",
        bullets: [
            "Bina aplikasi kustom, papan pemuka dan portal pelanggan",
            "Reka bentuk API, pangkalan data dan integrasi yang berskala",
            "Bekerjasama dengan pasukan automasi kami dalam pembangunan hujung-ke-hujung"
        ],
        subject: "Permohonan - Pembangun Full-Stack",
        isOpen: false
    },
    {
        title: "Pakar Pelaksanaan AI",
        engagement: "Kontrak · Separuh masa · Jarak jauh",
        hook: "Jambatan antara keperluan perniagaan dengan apa yang kami bina.",
        bullets: [
            "Kendalikan sesi penerokaan dan petakan aliran kerja sebenar pelanggan",
            "Tukar kekangan perniagaan kepada keperluan teknikal yang jelas",
            "Latih pasukan pelanggan dan pastikan sistem baharu benar-benar diguna pakai"
        ],
        subject: "Permohonan - Pakar Pelaksanaan AI",
        isOpen: false
    },
    {
        title: "Pembangunan Perniagaan & Jualan",
        engagement: "Komisen · Separuh masa · Sepenuh masa",
        hook: "Buka peluang, mulakan perbualan, materaikan perjanjian.",
        bullets: [
            "Cari dan tapis PKS yang bersedia untuk automasi dan AI",
            "Kendalikan panggilan penerokaan dan terjemah titik kesukaran kepada cadangan",
            "Bina perkongsian strategik yang membawa pelanggan jangka panjang"
        ],
        subject: "Permohonan - Pembangunan Perniagaan & Jualan",
        isOpen: false
    },
    {
        title: "Pemasar Pertumbuhan",
        engagement: "Kontrak · Separuh masa · Jarak jauh",
        hook: "Pastikan perniagaan yang tepat menemui kami terlebih dahulu.",
        bullets: [
            "Cipta kandungan LinkedIn, kajian kes dan kempen pemasaran",
            "Pacu SEO, iklan berbayar dan pendaftaran bengkel",
            "Ukur hasil prestasi dan gandakan usaha pada strategi yang berkesan"
        ],
        subject: "Permohonan - Pemasar Pertumbuhan",
        isOpen: false
    },
    {
        title: "Permohonan Terbuka",
        engagement: "Sebarang bentuk kerja · Jarak jauh",
        hook: "Tidak melihat peranan anda? Kemukakan cadangan anda.",
        bullets: [
            "Beritahu kami kepakaran anda dan bagaimana ia membantu PKS bekerja lebih pintar",
            "Pereka bentuk, pakar data, pengurus projek, pembina chatbot: kami ingin mendengar daripada anda",
            "Tunjukkan karya terbaik anda dan kami akan cari di mana ia paling sesuai"
        ],
        subject: "Permohonan - Permohonan Terbuka",
        isOpen: true
    }
];
---

<BaseLayout title="Kerjaya">
    <main>
        <!-- Hero Section -->
        <section class="careers-hero">
            <div class="container hero-container">
                <span class="label-micro" style="color: var(--black); margin-bottom: 1.5rem;">Sertai Tenaga Kerja Masa Depan</span>
                <h1 class="text-display" style="color: var(--black); margin-bottom: 2rem;">Bina<br>Leveraj.</h1>
                <p class="text-body-lg" style="max-width: 650px; color: var(--black); font-weight: 500;">
                    Kami bukan sekadar membina chatbot. Kami membina infrastruktur autonomi yang membolehkan kreativiti manusia berkembang dengan menghapuskan tugasan robotik masa kini.
                </p>
                
                <div class="status-ticker">
                    <span class="label-micro">STATUS_PENGGAJIAN: PENGAMBILAN_PASIF</span>
                    <div class="pulse"></div>
                </div>
            </div>
        </section>

        <!-- What We Do Section -->
        <section class="careers-intro">
            <div class="container grid-2">
                <div>
                    <h2 class="text-h2">Apa Yang Kami Bina.</h2>
                    <p class="text-body-lg" style="margin-top: 1.5rem; color: var(--gray-dark);">
                        Autoflow Solutions adalah agensi automasi yang cemerlang dan berimpak tinggi. Kami fokus pada PKS dan Perkhidmatan Profesional—tunjang ekonomi yang sering diabaikan oleh syarikat teknologi besar. Kami membawakan AI gred perusahaan kepada klinik tempatan, firma guaman butik, dan jenama e-dagang yang sedang berkembang.
                    </p>
                </div>
                <div class="info-card">
                    <h3 class="text-h3">Budaya Kami</h3>
                    <ul class="vibe-list">
                        <li><strong>Utamakan Kerja Jarak Jauh:</strong> Kami mengambil pekerja berdasarkan bakat, bukan lokasi geografi.</li>
                        <li><strong>Lancar Pantas, Tanpa Gangguan:</strong> Kami mengutamakan kebolehpercayaan yang kukuh berbanding faktor "menarik" yang sekadar eksperimen.</li>
                        <li><strong>Pemilikan Radikal:</strong> Anda bertanggungjawab ke atas hasil, bukan sekadar menyelesaikan tiket tugasan.</li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- Positions Section -->
        <section class="positions-section">
            <div class="container">
                <div class="positions-header">
                    <span class="label-micro" style="color: var(--neon);">RANGKAIAN BAKAT</span>
                    <h2 class="text-h2" style="color: var(--white); margin-top: 1rem;">Bina leveraj.</h2>
                    <p class="text-body-lg" style="color: var(--gray-light); max-width: 720px; margin-top: 1rem;">
                        Kami sentiasa mencari individu yang pantas menghasilkan kerja bermutu. Pilih trek yang sesuai dengan anda dan hantarkan CV, portfolio atau binaan terbaik anda. Kami menyimpan setiap profil dalam rangkaian bakat kami dan akan menghubungi anda apabila ada projek yang sepadan.
                    </p>
                </div>

                <div class="positions-grid">
                    {positions.map((p) => (
                        <div class={`position-card ${p.isOpen ? 'card-open' : ''}`}>
                            <div class="card-top">
                                <span class="engagement-pill">{p.engagement}</span>
                                <h3 class="card-title">{p.title}</h3>
                                <p class="card-hook">{p.hook}</p>
                            </div>

                            <ul class="card-bullets">
                                {p.bullets.map((b) => (
                                    <li>{b}</li>
                                ))}
                            </ul>

                            <div class="card-action">
                                <a 
                                    href={`mailto:career@autoflow-solutions.com?subject=${encodeURIComponent(p.subject)}`}
                                    class={`btn btn-card ${p.isOpen ? 'btn-neon' : 'btn-card-standard'}`}
                                >
                                    Mohon melalui Emel &rarr;
                                </a>
                                <div class="email-fallback">
                                    <span class="fallback-line">atau hantar ke: <code class="fallback-email">career@autoflow-solutions.com</code></span>
                                    <span class="fallback-subject">(Subjek: {p.subject})</span>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Talent Network Manifesto Section -->
        <section class="manifesto-section">
            <div class="container">
                <div class="manifesto-box">
                    <span class="label-micro manifesto-badge">RANGKAIAN BAKAT</span>
                    <p class="manifesto-text">
                        Ini adalah rangkaian bakat, bukan senarai kekosongan jawatan semasa. Kami menyemak setiap profil dan akan menghubungi anda apabila ada projek yang sesuai.
                    </p>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>

<style>
    .careers-hero {
        background-color: var(--neon);
        padding: 160px 0 100px;
        border-bottom: 2px solid var(--black);
    }

    .hero-container {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .status-ticker {
        display: flex;
        align-items: center;
        gap: 12px;
        background: var(--black);
        padding: 8px 16px;
        margin-top: 3rem;
        border-radius: 4px;
    }

    .status-ticker .label-micro {
        color: var(--white);
    }

    .pulse {
        width: 8px;
        height: 8px;
        background: #FACC15;
        border-radius: 50%;
        box-shadow: 0 0 0 0 rgba(250, 204, 21, 0.7);
        animation: pulse 2s infinite;
    }

    @keyframes pulse {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(250, 204, 21, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(250, 204, 21, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(250, 204, 21, 0); }
    }

    .careers-intro {
        padding: var(--space-xl) 0;
        background: var(--white);
    }

    .grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-xl);
        align-items: center;
    }

    .info-card {
        background: var(--gray-light);
        padding: var(--space-lg);
        border: 2px solid var(--black);
        box-shadow: 12px 12px 0 var(--black);
    }

    .vibe-list {
        list-style: none;
        padding: 0;
        margin-top: 1.5rem;
    }

    .vibe-list li {
        margin-bottom: 1rem;
        padding-left: 1.5rem;
        position: relative;
    }

    .vibe-list li::before {
        content: '>';
        position: absolute;
        left: 0;
        color: var(--black);
        font-weight: 900;
    }

    .positions-section {
        padding: var(--space-xl) 0;
        background: var(--black);
    }

    .positions-header {
        margin-bottom: var(--space-xl);
    }

    .positions-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
    }

    .position-card {
        border: 1px solid var(--gray-dark);
        padding: 2.25rem 2rem;
        background: rgba(255, 255, 255, 0.02);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
        border-radius: var(--radius-sm);
    }

    .position-card:hover {
        border-color: var(--neon);
        transform: translateY(-4px);
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.4), 0 0 20px rgba(196, 239, 23, 0.1);
    }

    /* Open Application Card (Inverted / Distinct Accent) */
    .position-card.card-open {
        border: 2px dashed var(--neon);
        background: linear-gradient(180deg, rgba(196, 239, 23, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%);
    }

    .position-card.card-open:hover {
        border-style: solid;
        border-color: var(--neon);
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.4), 0 0 30px rgba(196, 239, 23, 0.25);
    }

    .card-top {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
    }

    .engagement-pill {
        font-family: monospace;
        font-size: 0.75rem;
        color: var(--neon);
        letter-spacing: 0.03em;
        text-transform: uppercase;
        font-weight: 700;
    }

    .card-open .engagement-pill {
        color: var(--black);
        background: var(--neon);
        display: inline-block;
        align-self: flex-start;
        padding: 0.2rem 0.5rem;
        border-radius: 2px;
    }

    .card-title {
        color: var(--white);
        font-size: 1.4rem;
        font-weight: 800;
        line-height: 1.25;
        margin: 0;
    }

    .card-hook {
        color: #d1d5db;
        font-size: 0.95rem;
        font-style: italic;
        line-height: 1.45;
        margin: 0;
    }

    .card-bullets {
        list-style: none;
        padding: 0;
        margin: 0 0 2rem 0;
        flex-grow: 1;
    }

    .card-bullets li {
        color: var(--gray-light);
        font-size: 0.9rem;
        line-height: 1.5;
        margin-bottom: 0.75rem;
        padding-left: 1.25rem;
        position: relative;
    }

    .card-bullets li::before {
        content: '>';
        position: absolute;
        left: 0;
        color: var(--neon);
        font-weight: 900;
        font-family: monospace;
    }

    .card-action {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 0.75rem;
        margin-top: auto;
    }

    .btn-card {
        width: 100%;
        text-align: center;
        padding: 0.85rem 1rem;
        font-size: 0.95rem;
        font-weight: 700;
        border-radius: var(--radius-sm);
        text-decoration: none;
    }

    .btn-card-standard {
        background: transparent;
        color: var(--white);
        border: 2px solid rgba(255, 255, 255, 0.4);
        transition: all 0.2s ease;
    }

    .btn-card-standard:hover {
        background: var(--white);
        color: var(--black);
        border-color: var(--white);
    }

    .email-fallback {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 0.25rem;
        font-size: 0.75rem;
    }

    .fallback-line {
        color: #9ca3af;
    }

    .fallback-email {
        font-family: monospace;
        color: var(--neon);
        font-weight: 600;
        letter-spacing: -0.01em;
        user-select: all;
    }

    .fallback-subject {
        color: #9ca3af;
        font-size: 0.7rem;
    }

    /* Manifesto section replacing bottom apply-section */
    .manifesto-section {
        padding: var(--space-xl) 0;
        background: var(--black);
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .manifesto-box {
        max-width: 820px;
        margin: 0 auto;
        text-align: center;
        padding: 2.5rem 2rem;
        border: 1px solid rgba(255, 255, 255, 0.15);
        background: rgba(255, 255, 255, 0.02);
        border-radius: var(--radius-sm);
    }

    .manifesto-badge {
        color: var(--neon);
        letter-spacing: 0.15em;
        margin-bottom: 1rem;
        display: inline-block;
    }

    .manifesto-text {
        color: var(--white);
        font-size: 1.2rem;
        font-weight: 500;
        line-height: 1.6;
        margin: 0;
    }

    @media (max-width: 1100px) {
        .positions-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 1.5rem;
        }
    }

    @media (max-width: 768px) {
        .grid-2 { grid-template-columns: 1fr; }
        .positions-grid { grid-template-columns: 1fr; }
        .careers-hero { padding-top: 120px; }
        .position-card { padding: 1.75rem; }
    }
</style>
