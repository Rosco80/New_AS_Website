---
import BaseLayout from '../../layouts/BaseLayout.astro';
// Proof-first: real client builds only. Each card links to a full case study.
// Chips describe delivered scope, not unmeasured business metrics.
const cases = [
    {
        slug: "yap-chan-kor",
        tag: "Sistem Klinik",
        client: "Yap Chan Kor (MY)",
        headline: "Menggantikan perisian klinik siap-pakai dengan sistem milik klinik sendiri.",
        image: "/case-studies/yap-chan-kor/patient-guide-en.png",
        points: ["4 cawangan", "Web + apl klinik", "EN / MS / ZH", "Sedia e-invois"]
    },
    {
        slug: "raci-kenya",
        tag: "Platform Operasi",
        client: "Rent A Car in Kenya (KE)",
        headline: "Laman tempahan lima bahasa dan platform operasi yang menguruskan armada.",
        image: "/case-studies/raci-kenya/landing-hero-mobile.png",
        points: ["Laman tempahan + pejabat belakang", "5 bahasa", "M-Pesa + kad", "Sebut harga ke invois"]
    },
    {
        slug: "stem-agro",
        tag: "Perisikan Ladang",
        client: "STEM Agro",
        headline: "Platform perisikan ladang yang mengira perosak dan memberitahu pengurus langkah seterusnya.",
        image: "/case-studies/stem-agro/scout-rounds-synced.png",
        points: ["Tangkap hingga cadang", "CV + semakan manusia", "Berbilang penyewa", "M1 + M2 diterima"]
    }
];
---

<BaseLayout title="Kajian Kes">
    <header class="page-header">
        <div class="header-content">
            <h1 class="header-title">
                PENGGUNAAN <br>
                <span class="graphic-box">TERBUKTI</span> <br>
                <span class="graphic-box fill">HASIL // 01-03</span>
            </h1>
            <p style="max-width: 550px; font-size: 1.35rem; font-weight: 500; line-height: 1.5;">
                Sistem sebenar, dibina dan dihantar untuk perniagaan sebenar. Setiap satu boleh dibuka dan dibaca, bukan sekadar slaid. Klik mana-mana kad untuk kisah penuh.
            </p>
        </div>
    </header>

    <main class="case-grid">
        {cases.map((cs) => (
            <a class="case-study" href={`/case-studies/${cs.slug}`} aria-label={`Baca kajian kes ${cs.client}`}>
                <div class="case-content">
                    <span class="case-tag">{cs.tag}</span>
                    <div class="case-client">Pelanggan: {cs.client}</div>
                    <h3 class="case-headline">{cs.headline}</h3>
                    <ul class="points-grid">
                        {cs.points.map((point) => (
                            <li class="point-item">{point}</li>
                        ))}
                    </ul>
                    <span class="case-cta">Baca kajian kes &rarr;</span>
                </div>
            </a>
        ))}
    </main>

    <section style="padding: 12vw 4vw; text-align: center; border-bottom: var(--border-heavy);">
        <h2 style="font-size: 5rem; margin-bottom: 4rem; font-weight: 900; line-height: 0.9;">SEDIA MENJADI KISAH <br><span class="graphic-box fill">KEJAYAAN SETERUSNYA?</span></h2>
        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
            <a href="https://ai-self-audit.autoflow-solutions.com/" target="_blank" class="btn btn-solid">Mula Audit AI Percuma</a>
            <button data-cal-link="autoflow-solutions/book-a-discovery-call" data-cal-config='{"layout":"month_view"}' class="btn btn-outline">Tempah Sesi Konsultasi Percuma</button>
        </div>
    </section>

    <style>
        .page-header {
            padding: 12rem 4vw 5rem;
            background-color: var(--color-light-gray, #f4f4f4);
            border-bottom: var(--border-heavy, 3px solid #000);
            position: relative;
        }

        .page-header::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background-image: radial-gradient(#d0d0d0 1px, transparent 1px);
            background-size: 15px 15px;
            opacity: 0.4;
            pointer-events: none;
        }

        .header-content {
            position: relative;
            z-index: 1;
            max-width: 1200px;
        }

        .header-title {
            font-size: clamp(3.5rem, 10vw, 10rem);
            margin-bottom: 2.5rem;
            font-weight: 900;
            font-family: 'Barlow Condensed', sans-serif;
            text-transform: uppercase;
            line-height: 0.95;
            letter-spacing: -0.01em;
            word-wrap: break-word;
            overflow-wrap: break-word;
        }

        .graphic-box {
            display: inline-block;
            border: var(--border-heavy, 3px solid #000);
            padding: 0.05em 0.3em;
            background: var(--color-white, #fff);
            transform: rotate(-1deg);
            max-width: 100%;
        }

        .graphic-box.fill {
            background: var(--neon, #c4ef17);
            transform: rotate(0.8deg);
        }

        .case-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            border-bottom: var(--border-heavy, 3px solid #000);
        }

        .case-study {
            border-right: var(--border-heavy, 3px solid #000);
            border-bottom: var(--border-heavy, 3px solid #000);
            display: flex;
            flex-direction: column;
            text-decoration: none;
            color: inherit;
            transition: background 0.2s ease;
        }

        .case-study:hover, .case-study:focus-visible {
            background: var(--neon, #c4ef17);
        }

        .case-study:focus-visible {
            outline: 3px solid var(--black, #000);
            outline-offset: -3px;
        }

        .case-study:nth-child(even) {
            border-right: none;
        }

        .case-image-container {
            position: relative;
            height: 500px;
            overflow: hidden;
            border-bottom: var(--border-heavy, 3px solid #000);
        }

        .case-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: grayscale(100%) contrast(1.15);
            transition: transform 0.4s ease;
        }

        .case-study:hover .case-image {
            transform: scale(1.05);
        }

        .case-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: var(--neon, #c4ef17);
            mix-blend-mode: multiply;
            opacity: 0.25;
        }

        .case-tag {
            align-self: flex-start;
            background: var(--black, #000);
            color: var(--white, #fff);
            padding: 0.6rem 1.2rem;
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.9rem;
            letter-spacing: 0.05em;
            margin-bottom: 1.5rem;
        }

        .case-content {
            padding: 3.5rem 4vw;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }

        .case-client {
            font-family: 'Barlow Condensed', sans-serif;
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 1.25rem;
            opacity: 0.7;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }

        .case-headline {
            font-family: 'Barlow Condensed', sans-serif;
            text-transform: uppercase;
            line-height: 0.95;
            letter-spacing: -0.01em;
            font-size: 3.5rem;
            margin-bottom: 2.5rem;
            max-width: 95%;
            font-weight: 700;
        }

        .points-grid {
            list-style: none;
            display: flex;
            flex-wrap: wrap;
            gap: 0.6rem;
            padding: 2.5rem 0 0;
            margin: auto 0 0;
            border-top: 1px solid rgba(10, 10, 10, 0.2);
        }

        .point-item {
            border: 2px solid var(--black, #000);
            padding: 0.35rem 0.85rem;
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.9rem;
            letter-spacing: 0.02em;
            background: var(--white, #fff);
        }

        .case-cta {
            display: inline-block;
            margin-top: 2rem;
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-size: 1.05rem;
        }

        @media (max-width: 1024px) {
            .case-grid { grid-template-columns: 1fr; }
            .case-study { border-right: none; }
        }
        
        @media (max-width: 600px) {
            .page-header { padding: 6rem var(--space-md) 3rem; }
            .header-title { font-size: 3.2rem; }
            .case-image-container { height: 300px; }
            .case-content { padding: 2rem var(--space-md); }
            .case-headline { font-size: 2.2rem; margin-bottom: 1.5rem; }
            .points-grid { padding-top: 1.5rem; }
            
            section h2 { font-size: 2.8rem !important; margin-bottom: 2rem !important; }
        }
    </style>
</BaseLayout>
